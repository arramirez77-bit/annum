# Copy this file to .env (git-ignored) and fill in real values locally.
# Never commit real values. This file only lists the names.
#
# Where the real values live:
#   - Your Mac:        .env (git-ignored)
#   - The Worker:      `wrangler secret put ANNUM_WORKER_KEY` (Cloudflare stores it encrypted)
#   - App builds:      EAS environment variables (`eas env:create`)
#   - Teller cert/key: uploaded with `wrangler mtls-certificate upload` from a folder
#                      OUTSIDE this repo. They are never stored here.
#
# Note for M6: values the app needs at runtime must be exposed to Expo (for example
# with the EXPO_PUBLIC_ prefix). Anything bundled into the app can be read by someone
# who has the installed app, so only put values there that are safe to be seen.

# Teller application ID (from the Teller dashboard)
TELLER_APP_ID=

# URL of the Annum Cloudflare Worker (the Teller proxy)
ANNUM_WORKER_URL=

# Shared key the app sends as X-Annum-Key so only Annum can use the Worker
ANNUM_WORKER_KEY=
