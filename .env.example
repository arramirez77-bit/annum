# Copy this file to .env (git-ignored) and fill in real values locally.
# Never commit real values. This file only lists the names.
#
# Where the real values live:
#   - Your Mac:     .env (git-ignored), only for local development
#   - The Worker:   Cloudflare secrets, set with `wrangler secret put <NAME>` (stored encrypted
#                   by Cloudflare). PLAID_CLIENT_ID and PLAID_SECRET live ONLY there.
#   - App builds:   EAS environment variables (`eas env:create`)
#
# Anything bundled into the app can be read by someone who has the installed app, so the app
# only ever gets the Worker's URL and key — never the Plaid secret.

# --- Worker only (Cloudflare secrets; never in the app, never in this repo) ---
# From the Plaid Dashboard → Developers → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox while building, production for real banks (Trial plan)
PLAID_ENV=sandbox

# --- App and Worker ---
# URL of the Annum Cloudflare Worker (https://annum.<your-subdomain>.workers.dev)
ANNUM_WORKER_URL=

# Shared key the app sends as X-Annum-Key so only Annum can use the Worker
ANNUM_WORKER_KEY=
