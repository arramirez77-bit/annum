.env*
!.env.example
*.pem
*.key
*.p8
*.p12
*.crt
*.cer
*.mobileprovision
*.jks
*.keystore
certs/
credentials.json
GoogleService-Info.plist
.wrangler/

# ── Personal financial data: bank files, databases, exports ──────────
*.db
*.db-*
*.sqlite*
exports/
imports/
*.csv
*.ofx
*.qfx
!fixtures/**/*.csv
!fixtures/**/*.ofx
!fixtures/**/*.qfx
maestro/screenshots/

# ── Design exports from the private Figma file (stay on Andy's Mac) ──
docs/screens/*
!docs/screens/README.md

