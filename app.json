{
  "expo": {
    "name": "Annum",
    "slug": "annum",
    "version": "0.1.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "scheme": "annum",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111E19",
    "ios": {
      "bundleIdentifier": "com.highdesert.annum",
      "appleTeamId": "YHZESG76UG",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Bank download",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["public.comma-separated-values-text", "com.highdesert.annum.ofx"]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.highdesert.annum.ofx",
            "UTTypeDescription": "OFX bank download",
            "UTTypeConformsTo": ["public.data"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["ofx", "qfx"],
              "public.mime-type": ["application/x-ofx", "application/vnd.intu.qfx"]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "associatedDomains": ["applinks:annum.highdesert.workers.dev"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111E19"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Annum uses Face ID to keep your money private."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Annum uses Face ID to keep your money private."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f072493d-428e-496f-b175-46d99ea783f5"
      },
      "workerUrl": "https://annum.highdesert.workers.dev"
    },
    "owner": "arramirez77"
  }
}
